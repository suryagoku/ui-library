{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@my-org/ui": ["../../packages/ui/src/index.ts"],
      "@my-org/ui/components": ["../../packages/ui/src/components"],
      "@my-org/ui/components/*": ["../../packages/ui/src/components/*"],
      "@my-org/ui/lib": ["../../packages/ui/src/lib"],
      "@my-org/ui/lib/*": ["../../packages/ui/src/lib/*"]
    }
  },
  "include": ["src"]
}
