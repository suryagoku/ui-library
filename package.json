{
  "name": "ui-library",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:docs": "pnpm --filter @my-org/docs dev",
    "dev:storybook": "pnpm --filter @my-org/docs storybook",
    "build:storybook": "pnpm --filter @my-org/docs build-storybook"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
