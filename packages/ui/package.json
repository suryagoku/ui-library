{
  "name": "@suryagoku/ui",
  "version": "0.4.1",
  "private": false,
  "description": "Shared React component library",
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#components": "./src/components",
    "#components/*": "./src/components/*.tsx",
    "#hooks": "./src/hooks",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*.ts"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:js": "tsdown",
    "build:css": "postcss src/styles/globals.css -o dist/styles.css",
    "build": "pnpm run build:js && pnpm run build:css",
    "typecheck": "tsc -p .",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "shadcn": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0"
  }
}
