{
  "name": "@my-org/ui",
  "version": "0.1.0",
  "private": false,
  "description": "Shared React component library",
  "type": "module",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build:js": "tsdown",
    "build:css": "postcss src/styles/globals.css -o dist/styles.css",
    "build": "pnpm build:js && pnpm build:css",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.3"
  }
}
